{
  "expo": {
    "name": "first-expo-app",
    "slug": "first-expo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "firstexpoapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "アプリが写真にアクセスすることを許可しますか？",
          "cameraPermission": "アプリがカメラにアクセスすることを許可しますか？"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "アプリが写真にアクセスすることを許可しますか？",
          "savePhotosPermission": "アプリが写真を保存することを許可しますか？",
          "isAccessMediaLocationEnabled": true
                }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
